digraph smooth_lin {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=13, nodesep=0.35, ranksep=0.55, pad=0.3, bgcolor="white",
         label="Smooth field patching with linear heads: nonlinear only in the coordinates, linear in the data.\nOne set of weights for kinetic and adiabatic data and any resolution; only the point grid (coordinates, quadrature weights) changes.",
         labelloc=b, labeljust=c];
  node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#5b6770", fillcolor="#f4f6f8", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=10, color="#5b6770", arrowsize=0.7];

  subgraph cluster_coords {
    label="coordinate side (data independent, nonlinear)"; fontsize=12; style="rounded,dashed"; color="#8a6d3b"; fontcolor="#8a6d3b";
    pts [label="patch points p\nrelative offsets (s, x, y) in [-1, 1]\nabsolute (v‖, μ), channel\nlog physical half-width, species", fillcolor="#fdf3e1", color="#8a6d3b"];
    enc [label="cosine encoding\ncos(m π (u+1)/2), cut at the band", fillcolor="#fdf3e1", color="#8a6d3b"];
    K   [label="filter MLP  K_r(p)\nSiLU, 2 × 256, R = 256", fillcolor="#fbe3b8", color="#8a6d3b"];
    psi [label="basis MLP  ψ_r(p)\nSiLU, 2 × 256, R' = 128", fillcolor="#fbe3b8", color="#8a6d3b"];
    phi [label="fixed cosines  φ_k(p)\nof the position in the patch\nmodes (2, 2, 3, 2): K = 24", fillcolor="#fdf3e1", color="#8a6d3b"];
    w   [label="quadrature weights  w_p", fillcolor="#fdf3e1", color="#8a6d3b"];
    pts -> enc; enc -> K; enc -> psi;
  }

  subgraph cluster_enc {
    label="encoder (linear in x)"; fontsize=12; style="rounded"; color="#2c6e91"; fontcolor="#2c6e91";
    x   [label="patch values  x_p", fillcolor="#e3f0f7", color="#2c6e91"];
    h   [label="projections\nh_kr = mean_p  w_p φ_k(p) K_r(p) x_p\n(K × R = 6144)", fillcolor="#e3f0f7", color="#2c6e91"];
    W   [label="Linear  W\nz = W h", fillcolor="#cfe5f2", color="#2c6e91"];
    x -> h;
    h -> W;
  }

  z [label="token  z\n(dim 1024)", shape=box, style="rounded,filled,bold", fillcolor="#e8e8e8", color="#333333"];
  trunk [label="backbone\n(Swin / ViT / Transolver)", shape=box, style="rounded,dashed", color="#999999", fontcolor="#777777", fillcolor="white"];

  subgraph cluster_dec {
    label="decoder (linear in z)"; fontsize=12; style="rounded"; color="#3c7a3c"; fontcolor="#3c7a3c";
    B   [label="Linear  B (zero init)\nc = B z", fillcolor="#d9eed9", color="#3c7a3c"];
    c   [label="codes  c_kr\n(K × R' = 3072)", fillcolor="#e9f5e9", color="#3c7a3c"];
    u   [label="field\nu(p) = Σ_kr  c_kr φ_k(p) ψ_r(p)", fillcolor="#e9f5e9", color="#3c7a3c"];
    B -> c -> u;
  }

  K -> h [style=dashed, color="#8a6d3b"];
  phi -> h [style=dashed, color="#8a6d3b"];
  w -> h [style=dashed, color="#8a6d3b"];
  W -> z;
  z -> trunk [style=dashed, color="#999999"];
  trunk -> B [style=dashed, color="#999999"];
  psi -> u [style=dashed, color="#8a6d3b"];
  phi -> u [style=dashed, color="#8a6d3b"];
}
